# =================================================================
#  P&ID Studio Web Platform - Environment Configuration Template
# =================================================================

# --- Application Core ---
PROJECT_NAME="P&ID Studio Web Platform"
APP_ENV=production
DEBUG=false
LOCAL_DEV_AUTH_BYPASS=false
API_V1_PREFIX=/api/v1

# --- Multi-Tenancy & User Auth ---
DEFAULT_TENANT_ID=default_tenant
DEFAULT_USER_ID=default_user

# --- Database Connection ---
# For Docker Compose:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/pidstudio
DATABASE_SYNC_URL=postgresql://postgres:postgres@postgres:5432/pidstudio
# For Local Development without Docker:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pidstudio
# DATABASE_URL=sqlite+aiosqlite:///./pidstudio.db

# --- Redis & Task Queue ---
# For Docker Compose:
REDIS_URL=redis://redis:6379/0
# For Local Development without Docker:
# REDIS_URL=redis://localhost:6379/0
# Set True to execute Celery tasks synchronously in-process (no Redis/worker required):
CELERY_TASK_ALWAYS_EAGER=false
# Fast Trace (lines_only) otomatis untuk setiap sheet yang baru diunggah.
# Otomatis dilewati saat CELERY_TASK_ALWAYS_EAGER=true (tracing akan memblokir respons upload).
AUTO_TRACE_ON_UPLOAD=true

# --- File Storage & Model Paths ---
STORAGE_DIR=data/storage
WEIGHTS_DIR=runs
CACHE_DIR=.pidcache

# --- Perception Core Config-Driven Selection ---
# Symbol Detector: "yolo" (tiled baseline) or "sahi" (multi-scale inference)
DETECTOR_IMPL=yolo
# Text Extractor: "rapidocr" (high recall on engineering P&ID) or "paddleocr" (fast single-pass)
OCR_IMPL=rapidocr
# Line Tracer: "skeleton" (crossover separation, 100% association) or "morphology" (legacy)
TRACER_IMPL=skeleton

# --- Performance & Concurrency ---
OMP_NUM_THREADS=1
KMP_DUPLICATE_LIB_OK=TRUE

# --- Frontend Web Client ---
# Public API origin (without /api/v1). Set the externally reachable backend URL;
# leave empty only when a reverse proxy exposes /api on the website's own origin.
NEXT_PUBLIC_API_URL=
# Optional WebSocket origin. If empty, frontend derives it from NEXT_PUBLIC_API_URL or the current website origin.
NEXT_PUBLIC_WS_URL=
PORT=3000

# --- CORS ---
# Set the exact deployed website origin(s) when browser and API use different origins. Values are JSON.
CORS_ORIGINS=[]

# --- BIMA SSO (live by default; register the redirect URI in BIMA) ---
BIMA_BASE_URL=
BIMA_CLIENT_ID=
# Public frontend values are embedded in the Next.js build. Keep the base URL and client ID aligned with backend BIMA config.
NEXT_PUBLIC_BIMA_BASE_URL=
NEXT_PUBLIC_BIMA_CLIENT_ID=
# Must exactly match the redirect URI registered in BIMA. If empty, frontend uses the current website origin + /login.
NEXT_PUBLIC_BIMA_REDIRECT_URI=
NEXT_PUBLIC_LOCAL_DEV_AUTH_BYPASS=false
BIMA_SSO_MOCK_MODE=false
BIMA_PROJECTS_MOCK_MODE=false
