# =================================================================
#  P&ID Studio Web Platform - Environment Configuration Template
# =================================================================

# --- Application Core ---
PROJECT_NAME="P&ID Studio Web Platform"
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Multi-Tenancy & User Auth ---
DEFAULT_TENANT_ID=default_tenant
DEFAULT_USER_ID=default_user

# --- Database Connection ---
# For Docker Compose:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/pidstudio
DATABASE_SYNC_URL=postgresql://postgres:postgres@postgres:5432/pidstudio
# For Local Development without Docker:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pidstudio
# DATABASE_URL=sqlite+aiosqlite:///./pidstudio.db

# --- Redis & Task Queue ---
# For Docker Compose:
REDIS_URL=redis://redis:6379/0
# For Local Development without Docker:
# REDIS_URL=redis://localhost:6379/0
# Set True to execute Celery tasks synchronously in-process (no Redis/worker required):
CELERY_TASK_ALWAYS_EAGER=false
# Fast Trace (lines_only) otomatis untuk setiap sheet yang baru diunggah.
# Otomatis dilewati saat CELERY_TASK_ALWAYS_EAGER=true (tracing akan memblokir respons upload).
AUTO_TRACE_ON_UPLOAD=true

# --- File Storage & Model Paths ---
STORAGE_DIR=data/storage
WEIGHTS_DIR=runs
CACHE_DIR=.pidcache

# --- Perception Core Config-Driven Selection ---
# Symbol Detector: "yolo" (tiled baseline) or "sahi" (multi-scale inference)
DETECTOR_IMPL=yolo
# Text Extractor: "rapidocr" (high recall on engineering P&ID) or "paddleocr" (fast single-pass)
OCR_IMPL=rapidocr
# Line Tracer: "skeleton" (crossover separation, 100% association) or "morphology" (legacy)
TRACER_IMPL=skeleton

# --- Performance & Concurrency ---
OMP_NUM_THREADS=1
KMP_DUPLICATE_LIB_OK=TRUE

# --- Frontend Web Client ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
PORT=3000
